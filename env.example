# rate-limiter-middleware — example environment variables.
#
# This library has NO required runtime environment variables. These values are
# used only by example apps, benchmarks and integration scripts. Copy this file
# to `.env.local` (gitignored) and adjust as needed.

# Default window size in milliseconds for rate-limit windows.
RATE_LIMIT_WINDOW_MS=60000

# Default maximum number of requests allowed per window.
RATE_LIMIT_MAX=100

# Default port for the example Express server.
RATE_LIMIT_PORT=3000
